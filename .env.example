APP_NAME="TPIX TRADE"
APP_ENV=local
APP_KEY=
# Set to true only for local development
APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

# Xman Studio
XMAN_STUDIO_VERSION=1.0.0
XMAN_STUDIO_WEBSITE=https://xmanstudio.com

# Localization
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Encryption
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL recommended for production)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=admin_tpix
DB_USERNAME=admin_tpix
DB_PASSWORD=

# Session (production: redis, dev/CI: file)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Session security — enabled by default, override for local dev if needed
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Broadcasting
BROADCAST_CONNECTION=reverb

# Filesystem
FILESYSTEM_DISK=local

# Queue (production: redis, dev/CI: sync)
QUEUE_CONNECTION=sync

# Cache (production: redis, dev/CI: file)
CACHE_STORE=file
CACHE_PREFIX=tpixtrade

# Redis (set SESSION_DRIVER/CACHE_STORE/QUEUE_CONNECTION to redis in production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Development = log, Production = resend)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="tpixtrade@xman4289.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (สำหรับ production — สมัครที่ https://resend.com)
RESEND_API_KEY=

# Reverb (WebSocket) — IMPORTANT: Generate strong secrets for production!
REVERB_APP_ID=tpixtrade
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

#############################################
# Web3 & Blockchain Configuration
#############################################

# Default Chain
DEFAULT_CHAIN_ID=56

# Infura (Optional)
INFURA_PROJECT_ID=
INFURA_PROJECT_SECRET=

# Alchemy (Optional)
ALCHEMY_API_KEY=

# WalletConnect (สมัครที่ https://cloud.reown.com)
WALLETCONNECT_PROJECT_ID=52dc35105b74ddd9ade472de308b02d5
VITE_WALLETCONNECT_PROJECT_ID="${WALLETCONNECT_PROJECT_ID}"

#############################################
# Security
#############################################

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_TRADING_PER_MINUTE=100

# 2FA
TWO_FACTOR_ENABLED=true

# Encryption Keys (AES-256)
ENCRYPTION_KEY=

#############################################
# Social Authentication
#############################################

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=${APP_URL}/auth/twitter/callback

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=${APP_URL}/auth/discord/callback

#############################################
# AI Configuration
#############################################

AI_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Turnstile (Bot Protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

#############################################
# Trading Configuration
#############################################

# Fee (in percentage, e.g., 0.1 = 0.1%)
TRADING_FEE_PERCENTAGE=0.1
TRADING_FEE_WALLET=

# Limits
MAX_ORDER_SIZE_USD=1000000
MIN_ORDER_SIZE_USD=1

# Slippage
DEFAULT_SLIPPAGE_TOLERANCE=0.5
MAX_SLIPPAGE_TOLERANCE=5

# Stripe Payment (สำหรับ ICO Token Sale)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# TPIX Chain (Master Wallet — admin validator)
TPIX_MASTER_WALLET=
TPIX_RPC_URL=https://rpc1.tpix.online
TPIX_CHAIN_ID=4289

# Token Factory (deploy ERC-20 tokens on TPIX Chain)
DEPLOYER_PRIVATE_KEY=
TOKEN_FACTORY_ADDRESS=
# ยืนยันซอร์สบน explorer เป็นบริการเสียเงิน — nginx ของ explorer ปิดช่องยืนยันสาธารณะ
# รับเฉพาะคำขอที่มี header X-TPIX-Verify-Key ตรงกับค่านี้ (สุ่มยาว ๆ ตั้งค่าเดียวกันทั้งสองฝั่ง)
BLOCKSCOUT_VERIFY_KEY=

#############################################
# GitHub (สำหรับระบบอัพเดตแอป - repo private ได้)
#############################################
GITHUB_OWNER=xjanova
GITHUB_REPO=ThaiXTrade
# สร้าง token ที่: https://github.com/settings/tokens
# ต้องมีสิทธิ์: repo (read) สำหรับ private repo
GITHUB_TOKEN=

#############################################
# Image Generation (Cloudflare Worker)
#############################################
IMAGE_GEN_URL=https://tpix-image-gen.xjanovax.workers.dev/
IMAGE_GEN_API_KEY=

#############################################
# Masternode / Validator Auto-Allowlist
#############################################
# Cloudflare API — manage IP Access Rules (allowlist for masternode operators)
# Token permissions: Zone:Firewall Services:Edit on the tpix.online zone
CF_API_TOKEN=
CF_ZONE_ID=

# NodeRegistry contract address บน TPIX Chain (Phase 2 — เมื่อ deploy)
# ปล่อยว่างได้ — fallback ใช้ genesis_operators (config/masternode.php) + balance check
NODE_REGISTRY_ADDRESS=

# Heartbeat tuning (defaults work — set ถ้าต้อง override)
MASTERNODE_HEARTBEAT_TTL=3600
MASTERNODE_TIMESTAMP_WINDOW=300
MASTERNODE_RATE_LIMIT=10
MASTERNODE_MIN_RENEW=60
# 180 วัน — แอปมาสเตอร์โหนดอ่านค่านี้จาก /api/v1/masternode/config แล้วขอไม่เกินนี้
MASTERNODE_DELEGATION_LIFETIME=15552000
MASTERNODE_FALLBACK_MIN_BALANCE=100000
MASTERNODE_LOG_CHANNEL=daily

# CF header trust — true (default): trust CF-Connecting-IP only when CF-Ray present.
# Set false ถ้า origin server เข้าถึงได้ direct (bypass Cloudflare) เพื่อกัน IP spoof
MASTERNODE_TRUST_CF_HEADERS=true

# ── Uptime oracle (รันโหนดจริงเท่านั้นถึงได้รางวัล) — docs/MASTERNODE_UPTIME_ORACLE.md ──
# bootnode สาธารณะ คั่นด้วยจุลภาค: /ip4/123.253.62.252/tcp/30301/p2p/16Uiu2HAm...
MASTERNODE_PUBLIC_BOOTNODES=
# token ที่ cron tpix-node-peers บนเครื่องเชนใช้รายงานรายชื่อ peer (สุ่มยาว ≥ 32 ตัว แยกจาก TPIX_INFRA_ALERT_TOKEN)
TPIX_NODE_PEERS_TOKEN=
# กุญแจ uptime oracle — keystore V3 ใหม่เฉพาะงานนี้ ห้ามใช้กุญแจ owner/deployer/treasury
MASTERNODE_ORACLE_KEYSTORE_PATH=
MASTERNODE_ORACLE_KEYSTORE_PASS=
MASTERNODE_ORACLE_ADDRESS=
MASTERNODE_UPTIME_PERIOD_MINUTES=60
MASTERNODE_UPTIME_MAX_BLOCK_LAG=60
MASTERNODE_UPTIME_REQUIRE_PEER=true
MASTERNODE_UPTIME_FEED_COVERAGE=0.8
MASTERNODE_UPTIME_BATCH_SIZE=50
# GeoLite2 (ประเทศ/เมืองของโหนด) — สมัครฟรีที่ maxmind.com แล้ว php artisan geoip:update
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  ชั้นคลัง TPIX (Treasury)
# ══════════════════════════════════════════════════════════════════════════
#
# กระเป๋าคลัง 6 ใบตั้งไว้ใน config/treasury.php แล้ว — ที่นี่มีแต่ของกระเป๋าร้อน
# คลัง 6 ใบดูอย่างเดียว ระบบไม่มีคีย์ของมันและจะไม่มี
#
# ⚠️ การจ่ายเงินจะยังไม่ทำงานจนกว่าจะครบทั้ง 4 อย่าง:
#     1. TPIX_TREASURY_PAYOUTS_ENABLED=true
#     2. วางไฟล์ keystore ตาม TPIX_HOT_WALLET_KEYSTORE (สิทธิ์ 600, เจ้าของเป็น user ที่รัน php)
#        ⚠️ พาธต้องอยู่ใน open_basedir ของ PHP ฝั่งเว็บ — เซิร์ฟเวอร์ DirectAdmin
#        จำกัดไว้ที่ /home/admin/ การวางที่ /etc/tpix/ จะอ่านไม่ได้เลย
#        /home/admin/.tpix/ ปลอดภัยเท่ากันเพราะอยู่นอก public_html
#     3. TPIX_HOT_WALLET_PASS ตรงกับ keystore
#     4. กระเป๋าร้อนมีเงิน
#   ดูสถานะได้ที่ /admin/treasury มันจะบอกว่าเหลืออะไร

TPIX_HOT_WALLET_ADDRESS=0x78B81dF5345e69ef7A1af231dE1C5b1b30869C8f
TPIX_HOT_WALLET_KEYSTORE=/home/admin/.tpix/hot-wallet.keystore.json

# passphrase ของ keystore — ห้ามเก็บใน database ห้าม commit
TPIX_HOT_WALLET_PASS=

# เตือนเมื่อกระเป๋าร้อนต่ำกว่านี้ (TPIX) · 0 = ปิดการเตือน
TPIX_HOT_WALLET_LOW_WARNING=1000000

# สวิตช์หลัก — ค่าเริ่มต้นคือปิด ต้องตั้งใจเปิดเอง
TPIX_TREASURY_PAYOUTS_ENABLED=false

# วงเงิน (TPIX) · 0 = ไม่จำกัด
TPIX_TREASURY_MAX_PER_TX=1000000
TPIX_TREASURY_MAX_PER_DAY=10000000
TPIX_TREASURY_REQUIRE_WHITELIST=true
# ส่งขึ้นเชนไปเกินกี่นาทีแล้วยังไม่ลงบล็อก = ขึ้นคาดแดงในหลังบ้าน (รายการถัดไปรอจนตัวก่อนลงบล็อกเสมอ ไม่ว่าค่านี้จะเป็นเท่าไร)
TPIX_TREASURY_STUCK_MINUTES=10

# ─── TPIX Stability Reserve (กองทุนพยุงราคาแบบกฎตายตัว) ───────────────
# เทรดจากกระเป๋าใบนี้ใบเดียว (ที่อยู่แสดงบนหน้า /stability) — ห้ามใช้ใบเดียวกับคลัง/กระเป๋าร้อน
# เซ็นด้วย keystore V3 ผ่าน scripts/blockchain/stabilizer-sign.cjs (CLI เท่านั้น)
#
# จะเทรดจริงก็ต่อเมื่อ: STABILIZER_ENABLED=true + เปิดสวิตช์ที่ /admin/stabilizer (พิมพ์ ENABLE)
# + keystore ตรงกับที่อยู่ + มีเงินในกระเป๋า + พูลลึกพอตามกฎ
STABILIZER_ENABLED=false
STABILIZER_WALLET_ADDRESS=
STABILIZER_KEYSTORE_PATH=/home/admin/.tpix/stability-reserve.keystore.json
# passphrase ของ keystore — ห้ามเก็บใน database ห้าม commit
STABILIZER_KEYSTORE_PASS=
# เปิดเมื่อโมดูลสะพานมีหลักฐานทุนสำรอง (proof of reserves) แล้วเท่านั้น
# ปิด = ใช้ได้เฉพาะ USDT ที่เจ้าของฝากและบันทึกที่ /admin/stabilizer
STABILIZER_BRIDGE_RESERVES=false
# ให้ AI เรียบเรียงรายงานรายวัน (ใช้คีย์ OpenAI ตัวเดียวกับผู้ช่วย AI) — ปิดก็ยังออกรายงานตัวเลข
STABILIZER_REPORT_AI=true

# ส่วนต่างที่ยอมให้ตัวกระทบยอดผ่าน (wei) · 0 = ต้องตรงเป๊ะทุก wei
TPIX_TREASURY_RECONCILE_TOLERANCE=0

# ─────────────────────────────────────────────────────────────────────────────
# สะพาน USDT หลายเชน → TPIX Chain (config/bridge.php · หลังบ้าน /admin/bridge)
# ─────────────────────────────────────────────────────────────────────────────
# ติดตั้งแล้วหรือยัง — false = ไม่สแกน ไม่ mint ไม่จ่าย (ต้องเปิดสวิตช์ใน /admin/bridge อีกชั้น)
BRIDGE_ENABLED=false
# กระเป๋าเก็บเงินหนุน (EOA ของเจ้าของ ที่อยู่เดียวกันทุกเชน — เซิร์ฟเวอร์ไม่มีคีย์ใบนี้)
BRIDGE_VAULT_ADDRESS=0xf46131C82819d7621163F482b3fe88a228A7807c
# ปกติไม่ต้องตั้ง — deploy-bridge-minter.js ลงทะเบียนผ่าน /api/infra/contracts ให้เอง
BRIDGE_MINTER_ADDRESS=
# โอนเข้า vault จากที่อยู่เหล่านี้ = ย้ายเงินภายใน ไม่ mint (คั่นด้วย , · กระเป๋าจ่ายนับให้อัตโนมัติ)
BRIDGE_IGNORE_SENDERS=
# กุญแจ 3 ใบ คนละกระเป๋ากัน — keystore V3 นอก public_html (chmod 600) · passphrase ห้ามเก็บใน database ห้าม commit
#   relayer  = mint ผ่าน TPIXBridgeMinter (ถูกจำกัด maxPerTx/dailyCap บนสัญญา)
#   payout   = จ่าย USDT จริงบนเชนปลายทาง (ใบเดียวกันทุกเชน · ต้องเติม USDT + แก๊สทุกเชน)
#   guardian = สั่ง pause minter อย่างเดียว (ไม่บังคับ — ไม่ตั้งก็แค่ปิดสวิตช์หลังบ้าน + แจ้งเตือน)
BRIDGE_RELAYER_KEYSTORE=/home/admin/.tpix/bridge-relayer.keystore.json
BRIDGE_RELAYER_PASS=
BRIDGE_PAYOUT_KEYSTORE=/home/admin/.tpix/bridge-payout.keystore.json
BRIDGE_PAYOUT_PASS=
BRIDGE_GUARDIAN_KEYSTORE=
BRIDGE_GUARDIAN_PASS=
# ขาดเงินหนุนเกินเท่านี้ (USDT) สองรอบติด = หยุดสะพานเอง
BRIDGE_RECONCILE_TOLERANCE=1
# ไม่บังคับ: RPC ของแต่ละเชน (คั่นด้วย ,) · ปิดเชน · เปลี่ยน USDT บน OP เป็น USD₮0 (6 ทศนิยม)
# BRIDGE_RPC_1= BRIDGE_RPC_56= BRIDGE_RPC_137= BRIDGE_RPC_42161= BRIDGE_RPC_10= BRIDGE_RPC_43114=
# BRIDGE_CHAIN_1_ENABLED=true
# BRIDGE_OPTIMISM_USDT=0x94b008aA00579c1307B0EF2c499aD98a8ce58e58

# ─────────────────────────────────────────────────────────────────────────────
# ซื้อ TPIX ด้วย USDT (config/sale_crypto.php · หลังบ้าน /admin/token-sales กล่อง "ชำระด้วย USDT")
# ─────────────────────────────────────────────────────────────────────────────
# ติดตั้งแล้วหรือยัง — ยังต้องเพิ่ม "CRYPTO" ใน accept_currencies ของรอบขาย + ตั้ง sale_wallet_address
#   กระเป๋ารับเงิน = EOA เย็นของเจ้าของ (เซิร์ฟเวอร์ไม่มีคีย์) ห้ามเป็น vault ของสะพาน · ต้องเคยส่งธุรกรรมออกแล้ว (nonce > 0)
SALE_CRYPTO_ENABLED=false
# เชนที่รับ USDT (chain id คั่นด้วย , · ใช้ที่อยู่ USDT/RPC ชุดเดียวกับสะพาน BRIDGE_RPC_<id>)
SALE_CRYPTO_CHAINS=56
# SALE_CRYPTO_ORDER_TTL_MINUTES=30  SALE_CRYPTO_LATE_WINDOW_HOURS=72  SALE_CRYPTO_MAX_OPEN_ORDERS=3

# ─────────────────────────────────────────────────────────────────────────────
# สะพาน TPIX (เชน 4289) ⇄ wTPIX (BEP-20 บน BSC) — config/wtpix_bridge.php · หลังบ้าน /admin/bridge/wtpix
# ─────────────────────────────────────────────────────────────────────────────
# สวิตช์แยกจากสะพาน USDT — false = ไม่สแกน ไม่ mint ไม่ปล่อย (ต้องเปิดสวิตช์ในหลังบ้านอีกชั้น)
WTPIX_BRIDGE_ENABLED=false
# ⚠️ ห้ามใช้ BRIDGE_VAULT_ADDRESS (นั่นคือกระเป๋า USDT) — ที่อยู่สามตัวนี้ "ตรึง" ที่นี่ สะพานไม่เชื่อทะเบียนสัญญา
# TPIXBridgeVault บนเชน 4289 (deploy-bridge-vault.js พิมพ์ให้ · ต้องตรงกับ wtpix_bridge_vault ในทะเบียน)
WTPIX_BRIDGE_VAULT_ADDRESS=
# wTPIX + WTPIXBridgeMinter บน BSC (deploy-wtpix-bsc.js พิมพ์สองบรรทัดนี้ให้)
WTPIX_BSC_ADDRESS=
WTPIX_BSC_MINTER_ADDRESS=
# 56 = BSC จริง · 97 = BSC testnet สำหรับซ้อม (เคอร์เซอร์/รายการแยกตาม chain id ไม่ปนกัน)
WTPIX_BRIDGE_BSC_CHAIN_ID=56
# กุญแจ 2 ใบ (keystore V3 นอก public_html · chmod 600) — แนะนำแยกจากกุญแจสะพาน USDT
#   relayer  = mint บน BSC (ต้องมี BNB) + release บนเชน 4289 (แก๊ส 0)
#   guardian = pause() minter บน BSC (ต้องมี BNB) + vault บนเชน 4289 เท่านั้น (ไม่บังคับ แต่ควรมี)
WTPIX_BRIDGE_RELAYER_KEYSTORE=/home/admin/.tpix/wtpix-bridge-relayer.keystore.json
WTPIX_BRIDGE_RELAYER_PASS=
WTPIX_BRIDGE_GUARDIAN_KEYSTORE=
WTPIX_BRIDGE_GUARDIAN_PASS=
# BNB ขั้นต่ำในกระเป๋า relayer ก่อนเซ็น mint (ต่ำกว่า = awaiting_liquidity)
WTPIX_BRIDGE_MIN_BNB=0.002
# ขาดเงินหนุนเกินเท่านี้ (TPIX) สองรอบติด = หยุดสะพานเอง
WTPIX_BRIDGE_RECONCILE_TOLERANCE=1
# ไม่บังคับ: RPC (คั่นด้วย ,) · บล็อกเริ่มสแกน (ว่าง = หัวปัจจุบัน ไม่ไล่ย้อนหลัง) · เพดานราคาแก๊ส BSC
# WTPIX_BRIDGE_TPIX_RPC_URLS= WTPIX_BRIDGE_BSC_RPC_URLS=
# WTPIX_BRIDGE_TPIX_START_BLOCK= WTPIX_BRIDGE_BSC_START_BLOCK=
# WTPIX_BRIDGE_BSC_MAX_GAS_GWEI=20

# Infra Alerts — token ให้ watchdog เซิร์ฟเวอร์เชนยิง heartbeat/alert เข้าคาดแดงหลังบ้าน
# ต้องตรงกับ TPIX_ALERT_TOKEN ใน /etc/tpix-watchdog.env บนเครื่องเชน (TPIX-Coin repo)
TPIX_INFRA_ALERT_TOKEN=
TPIX_INFRA_STALE_MINUTES=3

# ─────────────────────────────────────────────────────────────────────────────
# AI TRADE (บอทเทรดคลาวด์)
# ─────────────────────────────────────────────────────────────────────────────

# เปิดขายให้คนทั่วไปหรือยัง — ปิดไว้จนกว่าจะทดสอบกลยุทธ์ครบและมั่นใจ
# ปิดอยู่ = ผู้ใช้ทั่วไปเช่าแพลนเสียเงินไม่ได้ (โหมดทดลองยังใช้ได้ตามปกติ)
AIBOT_SALES_OPEN=false

# กระเป๋าของทีมงาน — ใช้ได้ทุกฟังก์ชันโดยไม่ต้องเช่าและไม่ต้องมีเครดิต
# คั่นด้วยจุลภาค ไม่ต้องสนใจตัวพิมพ์เล็ก/ใหญ่
# ⚠️ ใส่เฉพาะกระเป๋าของทีมงานจริงๆ — ได้สิทธิ์เต็มโดยไม่จ่ายอะไรเลย
AIBOT_ADMIN_WALLETS=

# เปิดให้เติมเครดิตหรือยัง — ต้องต่อตัวรับเงินจริงให้เสร็จก่อนเปิด
AIBOT_TOPUP_ENABLED=false

# เปิดโหมดเทรดจริงหรือยัง
# ⚠️ ห้ามเปิดจนกว่าจะมี endpoint ยืนยันสัญญาณ — ไม่งั้นบอทจะเสนอแต่ขาซื้อ
#    ตลอดกาล ไม่มีสัญญาณขาย และ SL/TP ไม่ทำงาน (ดูโน้ตในสมอง)
AIBOT_LIVE_ENABLED=false

# ─── แผนที่ (หน้า /validators รายงานตำแหน่งมาสเตอร์โหนด) ───────────────
# ชั้นไทล์ทำให้ซูมได้ลึกและได้รายละเอียดถนน/เมือง — ปล่อยว่างได้
# ว่าง = ใช้แผนที่ประเทศที่อยู่ในโปรเจกต์อย่างเดียว (ไม่พัง แค่ซูมได้ถึงระดับ 5)
#
# CARTO บังคับใช้ API key ตั้งแต่ปลาย ส.ค. 2026 — ไม่มีคีย์ = ไทล์ยังมาแต่มีลายน้ำ
# "API KEY REQUIRED" พาดทั้งแผนที่  ขอคีย์ฟรีที่ https://carto.com/basemaps/apikey
# (ฟรี 5 ล้านไทล์/เดือน) แล้วเอาคีย์มาแทน <คีย์ของเรา> ข้างล่าง
#
# ⚠️ repo เป็นสาธารณะ คีย์ต้องอยู่ในไฟล์นี้เท่านั้น ห้ามใส่ในโค้ด
# ⚠️ แก้แล้วต้อง php artisan config:cache
MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=<คีย์ของเรา>"
MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_MAX_ZOOM=15

# ── Carbon Credit ──
# เปิดให้ซื้อคาร์บอนเครดิตหรือยัง — เปิดได้ด้วย true เท่านั้น ค่าอื่น = ปิด (config/carbon.php)
# ⚠️ ห้ามเปิดจนกว่าจะมีขั้นจ่ายเงินที่ตรวจบนเชน — ตอนนี้ purchase ไม่ตรวจการจ่ายเงิน เปิด = แจกเครดิตฟรี
CARBON_PURCHASE_ENABLED=false
